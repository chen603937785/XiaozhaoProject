.wb-page{padding:24rpx 24rpx 48rpx;color:#18385f;box-sizing:border-box}
.wb-hero{position:relative;overflow:hidden;min-height:286rpx;padding:32rpx 34rpx;border-radius:34rpx;background:linear-gradient(130deg,#253e72 0%,#357fe8 58%,#79b8f5 100%);box-shadow:0 16rpx 36rpx rgba(47,113,203,.2);box-sizing:border-box}
.wb-hero-orb{position:absolute;border-radius:50%;border:1rpx solid rgba(255,255,255,.16);background:rgba(255,255,255,.08)}
.wb-orb-one{width:290rpx;height:290rpx;right:-105rpx;top:-140rpx}.wb-orb-two{width:210rpx;height:210rpx;right:25rpx;bottom:-150rpx}
.wb-hero-content{position:relative;z-index:1}.wb-topline{display:flex;justify-content:space-between;align-items:center;gap:10rpx;color:rgba(255,255,255,.88);font-size:22rpx}
.wb-brand{font-weight:600;letter-spacing:2rpx}.wb-date{white-space:nowrap}.wb-greeting{margin-top:37rpx;font-size:38rpx;font-weight:700;line-height:1.3;color:#fff}
.wb-hero-desc{font-size:24rpx;line-height:1.5;color:rgba(255,255,255,.86);margin-top:10rpx}
.wb-hero-chip{display:inline-block;margin-top:27rpx;padding:8rpx 18rpx;border-radius:24rpx;background:rgba(255,255,255,.18);font-size:21rpx;color:#fff}
.wb-login-card,.wb-panel,.wb-summary,.wb-guest-card{background:#fff;border-radius:28rpx;box-shadow:0 8rpx 30rpx rgba(30,76,137,.055)}
.wb-login-card{margin-top:28rpx;padding:38rpx 30rpx 30rpx;text-align:center}
.wb-login-mark{display:flex;justify-content:center;align-items:center;width:92rpx;height:92rpx;margin:0 auto 25rpx;border-radius:28rpx;background:#eaf2ff;color:#3286ee;font-size:52rpx}
.wb-login-title{font-size:32rpx;font-weight:700;line-height:1.4}.wb-login-copy{max-width:510rpx;margin:14rpx auto 0;color:#7d92a8;font-size:24rpx;line-height:1.6}
.wb-login-features{display:flex;justify-content:center;gap:24rpx;flex-wrap:wrap;margin:30rpx 0 22rpx;color:#466382;font-size:23rpx}
.wb-login-features>view{background:#f5f8fd;border-radius:18rpx;padding:14rpx 16rpx}.wb-feature-icon{margin-right:8rpx;color:#3286ee;font-size:28rpx}
.wb-main-btn{display:flex;justify-content:center;align-items:center;gap:18rpx;height:88rpx;line-height:88rpx;margin:0;border:0;border-radius:20rpx;background:linear-gradient(100deg,#2e74d5,#4c9af3);box-shadow:0 10rpx 22rpx rgba(50,134,238,.18);color:#fff;font-size:28rpx;font-weight:600}
.wb-main-btn:after,.wb-outline-btn:after,.wb-done-btn:after,.wb-todo-empty button:after{border:none}
.wb-login-foot{font-size:22rpx;color:#9aabbb;margin-top:22rpx}
.wb-guest-card{display:flex;align-items:center;gap:20rpx;padding:28rpx;margin-top:22rpx}
.wb-guest-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;flex-shrink:0;border-radius:22rpx;background:#fff4e5;color:#f0a133;font-size:46rpx}
.wb-guest-text{flex:1;min-width:0;font-size:27rpx;font-weight:600}.wb-guest-text text{display:block;margin-top:6rpx;font-size:22rpx;font-weight:400;color:#91a2b6}.wb-guest-arrow{font-size:40rpx;color:#adc0d3}
.wb-summary{display:flex;align-items:center;margin:26rpx 0 34rpx;padding:26rpx 10rpx}
.wb-summary-item{flex:1;text-align:center;display:flex;flex-direction:column;gap:8rpx;color:#7d92a8;font-size:22rpx}
.wb-summary-number{font-size:39rpx;font-weight:700;line-height:1.1;color:#4b87e5}.wb-number-orange{color:#e69c42}.wb-number-green{color:#35b779}.wb-summary-sep{height:54rpx;width:1rpx;background:#eaf0f7}
.wb-section-head{display:flex;align-items:center;justify-content:space-between;margin:32rpx 4rpx 17rpx;font-size:29rpx;font-weight:700}
.wb-section-dot{display:inline-block;width:9rpx;height:28rpx;background:#3286ee;border-radius:9rpx;margin-right:12rpx;vertical-align:-4rpx}.wb-dot-purple{background:#8b7cf6}.wb-dot-orange{background:#f0a133}
.wb-section-link{font-size:23rpx;font-weight:500;color:#3286ee}
.wb-panel{padding:28rpx}.wb-plan-title,.wb-plan-title>view{display:flex;align-items:center;gap:14rpx}.wb-plan-title{justify-content:space-between}
.wb-plan-icon{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;border-radius:18rpx;background:#eaf2ff;color:#3286ee}
.wb-plan-name{font-size:30rpx;font-weight:700;max-width:360rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.wb-plan-switch{font-size:23rpx;color:#3286ee}
.wb-plan-sub{margin:14rpx 0 29rpx;color:#8a9bb0;font-size:23rpx}
.wb-progress-line{height:13rpx;border-radius:12rpx;background:#edf3fa;overflow:hidden}.wb-progress-fill{height:100%;background:linear-gradient(90deg,#3286ee,#6db7fa);border-radius:12rpx}
.wb-progress-meta{display:flex;justify-content:space-between;color:#8599ad;font-size:22rpx;margin-top:13rpx}.wb-progress-meta text:last-child{color:#3286ee;font-weight:700}
.wb-plan-stats{display:flex;justify-content:space-around;margin-top:32rpx;padding:25rpx 0;border-top:1rpx solid #edf2f8;border-bottom:1rpx solid #edf2f8}
.wb-plan-stats>view{display:flex;flex-direction:column;align-items:center;gap:6rpx;color:#8ba0b5;font-size:22rpx}.wb-plan-stats text{font-size:33rpx;color:#18385f;font-weight:700}
.wb-plan-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:20rpx}.wb-outline-btn{height:65rpx;line-height:65rpx;margin:0;padding:0 23rpx;border:1rpx solid #d9e8fa;border-radius:14rpx;background:#f6faff;color:#3286ee;font-size:23rpx}
.wb-plan-empty{text-align:center;padding:24rpx 12rpx}.wb-empty-art{font-size:58rpx;color:#80acec;background:#eef5ff;border-radius:50%;width:106rpx;height:106rpx;line-height:106rpx;margin:0 auto 20rpx}
.wb-plan-empty>view:nth-child(2){font-size:29rpx;font-weight:700}.wb-plan-empty>text{display:block;margin:12rpx 0 30rpx;color:#91a4b8;font-size:23rpx;line-height:1.6}
.wb-stage-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13rpx}.wb-stage{background:#f6f9fd;border-radius:20rpx;padding:21rpx 8rpx;text-align:center}
.wb-stage-count{font-size:35rpx;font-weight:700;line-height:1.2}.wb-stage-name{font-size:22rpx;color:#8298ad;margin-top:6rpx}
.wb-stage-tip{text-align:center;margin-top:23rpx;font-size:22rpx;color:#9aabbb}
.wb-todo{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid #eff3f8}.wb-todo:last-child{border-bottom:0}.wb-todo-marker{width:12rpx;height:12rpx;border-radius:50%;background:#f0a133;flex-shrink:0}
.wb-todo-body{flex:1;min-width:0}.wb-todo-title{font-size:26rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.wb-todo-time{font-size:21rpx;color:#96a7b8;margin-top:7rpx}
.wb-done-btn{margin:0;padding:0 18rpx;line-height:56rpx;border-radius:12rpx;background:#ecf8f2;color:#35b779;font-size:22rpx}
.wb-todo-empty{text-align:center;padding:12rpx 0 4rpx}.wb-todo-empty>text:first-child{display:block;width:80rpx;height:80rpx;line-height:80rpx;margin:0 auto 17rpx;border-radius:50%;background:#ecf8f2;color:#35b779;font-size:42rpx}
.wb-todo-empty>view{font-size:27rpx;font-weight:600}.wb-todo-empty>text:nth-of-type(2){display:block;margin-top:8rpx;color:#99aabc;font-size:22rpx}.wb-todo-empty button{border:0;background:transparent;color:#3286ee;font-size:23rpx;margin-top:15rpx}
.wb-error,.wb-loading{font-size:23rpx;text-align:center;padding:20rpx;color:#e35d5d}.wb-loading{color:#94a6ba}
.wb-market-card{margin:26rpx 0 30rpx;padding:26rpx 20rpx;background:linear-gradient(145deg,#fff,#f5f9ff);border:1rpx solid #e5effb;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(50,134,238,.06)}
.wb-market-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:28rpx;color:#18385f;font-size:28rpx;font-weight:700}
.wb-live-pill{flex-shrink:0;padding:8rpx 14rpx;background:#eaf3ff;color:#3286ee;border-radius:22rpx 22rpx 22rpx 4rpx;font-size:20rpx;font-weight:500}
.wb-market-stats{display:flex;align-items:center}.wb-market-stats .wb-summary-item{font-size:21rpx}.wb-market-stats .wb-market-new{color:#ee8250}.wb-market-stats .wb-summary-number{font-variant-numeric:tabular-nums}
