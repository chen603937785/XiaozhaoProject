.page {
  padding: 24rpx;
}

.head {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.head-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.head-count {
  font-size: 24rpx;
  color: #324263;
  background: #b1ffec;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
}

.job-card {
  padding: 28rpx;
}
.job-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.job-type {
  display: flex;
  flex-wrap: wrap;
}
.job-deadline {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}
.job-deadline.deadline-soon {
  color: #c2855c;
}
.job-position {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 16rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.job-tags {
  margin-bottom: 12rpx;
}
.job-meta {
  display: flex;
  font-size: 24rpx;
  color: #999;
}
.meta-item {
  margin-right: 24rpx;
}
.meta-publish {
  color: #324263;
  font-weight: 500;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 30rpx 0;
}
