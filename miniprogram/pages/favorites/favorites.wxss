.page {
  padding: 24rpx;
}

.job-list {
  padding-bottom: 40rpx;
}
.job-card {
  padding: 28rpx;
}
.job-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.job-company {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.remove-btn {
  font-size: 24rpx;
  color: #ff5252;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ffcdd2;
  border-radius: 40rpx;
}
.job-position {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 16rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.job-tags {
  margin-bottom: 12rpx;
}
.job-meta {
  display: flex;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #999;
}
.meta-item {
  margin-right: 24rpx;
}
