.member-page{min-height:100vh;background:#fff;color:#18385f;padding-bottom:250rpx;box-sizing:border-box}.member-hero{padding:20rpx 24rpx 36rpx;background:linear-gradient(150deg,#deedff 0%,#f0f7ff 52%,#fff 100%)}.activity-pill{height:58rpx;padding:0 18rpx;display:flex;align-items:center;background:rgba(221,237,211,.76);border-radius:34rpx;box-shadow:0 5rpx 18rpx rgba(50,76,35,.07);font-size:22rpx;color:#52604e}.activity-avatar{width:36rpx;height:36rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e4f1ff;color:#18385f;font-size:19rpx;font-weight:700;margin-right:10rpx}.activity-time{margin-left:auto;color:#8e9a88}.identity-card{height:300rpx;margin-top:24rpx;padding:30rpx 28rpx;position:relative;overflow:hidden;border-radius:34rpx;background:linear-gradient(145deg,#285da6,#18385f);color:#fff;box-shadow:0 14rpx 30rpx rgba(9,9,9,.18)}.status-badge{display:inline-block;padding:9rpx 18rpx;border-radius:22rpx;background:#e4f1ff;color:#18385f;font-size:21rpx;font-weight:700}.card-title{margin-top:25rpx;color:#e7b86a;font-size:36rpx;font-weight:800}.crown{position:absolute;right:30rpx;top:8rpx;color:#e7b86a;font-size:112rpx;line-height:1;text-shadow:2rpx 3rpx 0 #a94736}.identity-bottom{position:absolute;left:28rpx;bottom:28rpx;display:flex;align-items:center}.user-avatar{width:72rpx;height:72rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#b8b5ff,#6766b6);color:#fff;font-size:29rpx;font-weight:700;margin-right:16rpx}.user-name{font-size:28rpx;font-weight:700}.user-sub{margin-top:7rpx;color:#b8b8b8;font-size:21rpx}.card-line{position:absolute;border:2rpx solid rgba(231,184,106,.3);border-radius:50%;transform:rotate(-20deg)}.line-a{width:420rpx;height:130rpx;right:-250rpx;bottom:-80rpx}.line-b{width:300rpx;height:90rpx;left:-190rpx;top:120rpx;border-color:rgba(223,255,134,.22)}.member-content{padding:0 24rpx}.section-title{font-size:34rpx;font-weight:800;padding:28rpx 2rpx 20rpx}.plan-row{display:flex;gap:14rpx}.plan-card{position:relative;flex:1;min-width:0;padding:27rpx 12rpx 20rpx;border-radius:24rpx;background:#fafafa;border:2rpx solid #ededed;box-sizing:border-box}.plan-selected{background:#edf5ff;border-color:#18385f;box-shadow:0 8rpx 15rpx rgba(9,9,9,.06)}.recommend{position:absolute;left:10rpx;top:-13rpx;padding:5rpx 12rpx;border-radius:18rpx;background:#18385f;color:#fff;font-size:18rpx}.plan-name{font-size:26rpx;font-weight:800;white-space:nowrap}.plan-days{margin-top:9rpx;color:#999;font-size:19rpx;white-space:nowrap}.plan-price{margin-top:18rpx;font-size:37rpx;font-weight:800;white-space:nowrap}.plan-daily{display:inline-block;margin-top:11rpx;padding:6rpx 8rpx;border-radius:14rpx;color:#999;font-size:17rpx;white-space:nowrap}.daily-selected{background:#e4f1ff;color:#18385f}.benefit-title{margin-top:12rpx}.benefit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.benefit-card{min-height:148rpx;padding:20rpx 16rpx;border-radius:26rpx;background:#fafafa;box-shadow:0 7rpx 20rpx rgba(9,9,9,.04);display:flex;align-items:center;box-sizing:border-box}.benefit-icon{width:58rpx;height:58rpx;flex:none;border-radius:20rpx;display:flex;align-items:center;justify-content:center;background:#fff0dd;color:#d78247;font-size:35rpx}.benefit-copy{margin-left:12rpx}.benefit-name{font-size:23rpx;font-weight:700;line-height:1.35}.benefit-name.gift{color:#d95745}.benefit-desc{margin-top:8rpx;color:#999;font-size:18rpx;line-height:1.35}.error{margin-top:20rpx;color:#d95745;text-align:center;font-size:23rpx}.bottom-space{height:36rpx}.pay-dock{position:fixed;left:0;right:0;bottom:0;padding:22rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);box-shadow:0 -8rpx 24rpx rgba(9,9,9,.08);z-index:20}.discount-tip{position:absolute;right:42rpx;top:-22rpx;padding:9rpx 16rpx;border-radius:17rpx 17rpx 17rpx 4rpx;background:#f48668;color:#fff;font-size:19rpx;box-shadow:0 5rpx 12rpx rgba(244,134,104,.2)}.pay-bar{height:94rpx;padding:0 12rpx 0 22rpx;display:flex;align-items:center;border-radius:48rpx;background:#18385f}.pay-total{color:#fff;font-size:39rpx;font-weight:800}.pay-total text{margin-left:6rpx;color:#b8b8b8;font-size:21rpx;font-weight:400}.pay-button{width:250rpx;height:70rpx;line-height:70rpx;margin:0 0 0 auto;padding:0;border-radius:38rpx;background:#e4f1ff;color:#18385f;font-size:27rpx;font-weight:800}.agreement{display:flex;align-items:center;justify-content:center;margin-top:16rpx;color:#666;font-size:20rpx}.check{width:28rpx;height:28rpx;margin-right:8rpx;border-radius:50%;border:2rpx solid #999;display:flex;align-items:center;justify-content:center;box-sizing:border-box;color:#fff;font-size:19rpx}.check.checked{background:#18385f;border-color:#18385f}.agreement text{white-space:nowrap}

/* 蓝色渐变主题，仅作用于本页，保留现有布局和业务逻辑。 */
.identity-card{background:linear-gradient(125deg,#232321 0%,#111110 65%,#090909 100%);box-shadow:0 14rpx 30rpx rgba(9,9,9,.18)}
.activity-pill{background:rgba(224,237,255,.85);color:#456689;box-shadow:0 5rpx 18rpx rgba(50,134,238,.07)}
.activity-avatar{background:linear-gradient(135deg,#3286ee,#72c5f4);color:#fff}.activity-time{color:#6d8199}
.user-avatar{background:linear-gradient(145deg,#d4eaff,#86baf1);color:#204c83}.user-sub{color:#d5e5f9}
.status-badge{background:linear-gradient(135deg,#fff,#d8ecff);color:#205da8}
.card-line,.line-b{border-color:rgba(208,231,255,.25)}
.plan-selected{border-color:#3286ee;background:linear-gradient(145deg,#e4f0ff,#f8fbff);box-shadow:0 8rpx 15rpx rgba(50,134,238,.08)}
.recommend{background:linear-gradient(135deg,#2875d7,#50a2f2)}
.daily-selected{background:#d9eaff;color:#205da8}.plan-days,.plan-daily,.benefit-desc{color:#657a94}
.benefit-card{background:linear-gradient(145deg,#f0f6ff,#fff);box-shadow:0 7rpx 20rpx rgba(50,134,238,.05)}
.pay-bar{background:linear-gradient(110deg,#203e70,#286bc4)}
.pay-button{background:linear-gradient(135deg,#fff,#d5eaff);color:#205da8}.pay-total text{color:#d5e5f9}
.check.checked{background:#3286ee;border-color:#3286ee}
.card-title,.crown{color:#e7b86a}.card-line,.line-b{border-color:rgba(231,184,106,.25)}
