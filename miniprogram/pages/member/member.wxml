<view class="member-page">
  <view class="member-hero">
    <view class="activity-pill"><view class="activity-avatar">麦</view><text>最近有同学开通了会员</text><text class="activity-time">刚刚</text></view>
    <view class="identity-card">
      <view class="status-badge">{{user.isVip ? '已开通' : '未开通'}}</view>
      <view class="card-title">小麦说职位会员</view><view class="crown">♛</view>
      <view class="identity-bottom"><view class="user-avatar">{{avatarName}}</view><view><view class="user-name">{{loggedIn ? (user.nickname || '同学') : '登录后开通'}}</view><view class="user-sub">开通会员尊享多项求职特权</view></view></view>
      <view class="card-line line-a"></view><view class="card-line line-b"></view>
    </view>
  </view>
  <view class="member-content">
    <view class="section-title">选择会员套餐</view>
    <view class="plan-row">
      <view wx:for="{{plans}}" wx:key="planType" class="plan-card {{selected === item.planType ? 'plan-selected' : ''}}" data-type="{{item.planType}}" bindtap="selectPlan">
        <view wx:if="{{item.planType === 'MONTH'}}" class="recommend">推荐</view>
        <view class="plan-name">{{item.name}}</view><view class="plan-days">{{item.days}}天有效</view><view class="plan-price">¥{{item.priceText}}</view><view class="plan-daily {{selected === item.planType ? 'daily-selected' : ''}}">折合 ¥{{item.dailyText}}/天</view>
      </view>
    </view>
    <view class="section-title benefit-title">会员权益介绍</view>
    <view class="benefit-grid"><view wx:for="{{benefits}}" wx:key="title" class="benefit-card"><view class="benefit-icon">{{item.icon}}</view><view class="benefit-copy"><view class="benefit-name {{item.gift ? 'gift' : ''}}">{{item.title}}</view><view class="benefit-desc">{{item.desc}}</view></view></view></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="bottom-space"></view>
  </view>
  <view class="pay-dock"><view class="discount-tip">{{countdown}} 后优惠结束</view><view class="pay-bar"><view class="pay-total">¥{{selectedPriceText}}<text>/会员</text></view><button class="pay-button" loading="{{paying}}" disabled="{{paying}}" bindtap="pay">{{user.isVip ? '立即续费' : '立即开通'}}</button></view><view class="agreement" bindtap="toggleAgreement"><view class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view><text>开通即代表同意《服务协议》和《支付协议》</text></view></view>
</view>
