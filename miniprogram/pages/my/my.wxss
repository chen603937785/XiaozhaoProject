.my-page{min-height:100vh;padding:0 24rpx 50rpx;background:#f3f7fc;color:#18385f;box-sizing:border-box}.my-top{margin:0 -24rpx;padding:54rpx 34rpx 26rpx;background:linear-gradient(145deg,#deedff 0%,#f0f7ff 46%,#fff 100%);border-radius:0 0 34rpx 34rpx}.my-profile{display:flex;align-items:center}.profile-avatar{width:104rpx;height:104rpx;border-radius:52rpx;background:#e4f1ff;color:#3286ee;display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:700;border:6rpx solid rgba(255,255,255,.8)}.profile-avatar-on{background:linear-gradient(135deg,#e4f1ff,#72c5f4);color:#18385f}.profile-copy{flex:1;margin-left:22rpx}.profile-name{font-size:38rpx;font-weight:800;color:#18385f}.profile-account{font-size:24rpx;color:#b8b8b8;margin-top:8rpx}.profile-login{font-size:54rpx;line-height:1;color:#18385f;padding-left:18rpx}.profile-vip-line{display:flex;align-items:center;margin-top:24rpx;color:#777;font-size:23rpx}.profile-vip-dot{width:16rpx;height:16rpx;border-radius:50%;background:#b8b8b8;margin-right:12rpx}.profile-vip-dot.is-vip{background:#e7b86a}.profile-chevron{margin-left:auto;color:#777;font-size:34rpx}.member-card{position:relative;overflow:hidden;margin:20rpx 0 24rpx;padding:28rpx 24rpx 22rpx;min-height:252rpx;border-radius:34rpx;background:#18385f;color:#fff;box-shadow:0 12rpx 24rpx rgba(9,9,9,.16)}.member-card-active{background:linear-gradient(145deg,#285da6,#18385f)}.member-promo-title{position:relative;z-index:2;color:#e7b86a;font-size:30rpx;font-weight:700}.member-crown{position:absolute;right:28rpx;top:4rpx;color:#e7b86a;font-size:104rpx;line-height:1;text-shadow:0 0 0 #b6422f,2rpx 3rpx 0 #b6422f}.member-feature-row{position:absolute;left:24rpx;right:24rpx;bottom:24rpx;display:flex;justify-content:space-between;z-index:2}.member-feature-row view{display:flex;flex-direction:column;align-items:center;min-width:112rpx;color:#fff;font-size:21rpx}.feature-icon{height:38rpx;font-size:32rpx;line-height:34rpx;color:#fff;margin-bottom:7rpx}.member-unlock{position:absolute;right:24rpx;bottom:76rpx;z-index:3;padding:14rpx 22rpx;border-radius:28rpx;background:#e4f1ff;color:#18385f;font-size:24rpx;font-weight:700;box-shadow:0 5rpx 12rpx rgba(223,255,134,.18)}.member-decor{position:absolute;border:2rpx solid rgba(231,184,106,.45);border-radius:50%;transform:rotate(-24deg)}.decor-one{width:350rpx;height:110rpx;left:-120rpx;bottom:-54rpx}.decor-two{width:440rpx;height:170rpx;right:-230rpx;top:70rpx;border-color:rgba(223,255,134,.28)}.redeem-inline{position:absolute;left:24rpx;right:24rpx;bottom:22rpx;display:none}.redeem-inline input{height:58rpx}.member-card-active .redeem-inline{display:none}.member-message{display:none}.my-menu{padding:6rpx 18rpx;background:#fff;border-radius:30rpx;box-shadow:0 5rpx 20rpx rgba(0,0,0,.04)}.menu-row{display:flex;align-items:center;padding:29rpx 0;border-bottom:1rpx solid #f0f0f0}.menu-row:last-child{border-bottom:0}.menu-icon{width:52rpx;text-align:center;margin-right:22rpx;color:#18385f;font-size:38rpx;line-height:1}.menu-follow{font-size:31rpx}.menu-contact{font-size:34rpx}.menu-setting{font-size:32rpx}.menu-label{flex:1;font-size:29rpx;color:#18385f;font-weight:500}.menu-arrow{font-size:42rpx;line-height:1;color:#18385f}.menu-star{font-size:32rpx}.menu-logout{font-size:32rpx}.auth-mask,.contact-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(9,9,9,.5);z-index:100}.contact-mask{z-index:110}.auth-sheet{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:34rpx 34rpx 0 0;padding:32rpx 28rpx 44rpx;z-index:101}.auth-sheet-head{display:flex;justify-content:space-between;align-items:flex-start}.auth-title{font-size:34rpx;font-weight:700;color:#18385f}.auth-subtitle{font-size:23rpx;color:#999;margin-top:7rpx}.auth-close{font-size:44rpx;line-height:36rpx;color:#999;padding:0 8rpx}.auth-tabs{display:flex;gap:28rpx;border-bottom:1rpx solid #f0f0f0;margin-top:24rpx}.auth-tab{padding:0 4rpx 15rpx;color:#999;font-size:27rpx;position:relative}.auth-tab.active{color:#18385f;font-weight:700}.auth-tab.active:after{content:'';position:absolute;bottom:-1rpx;left:0;right:0;height:5rpx;border-radius:5rpx;background:#e4f1ff}.auth-field{margin:16rpx 0 0;background:#f3f7fc;border-color:#f0f0f0}.auth-submit{width:100%;margin-top:22rpx;height:82rpx;line-height:82rpx;background:#18385f;color:#e4f1ff}.contact-dialog{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:560rpx;background:#fff;border-radius:30rpx;padding:34rpx 28rpx 26rpx;box-sizing:border-box;z-index:111;text-align:center}.contact-title{font-size:34rpx;font-weight:700;color:#18385f}.contact-subtitle{font-size:24rpx;color:#999;margin-top:8rpx}.contact-qr{width:420rpx;height:420rpx;margin:22rpx auto 16rpx;display:block}.contact-empty{height:300rpx;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:25rpx}.contact-close{border-top:1rpx solid #f0f0f0;padding-top:22rpx;color:#18385f;font-size:28rpx}.message{color:#d95745;font-size:24rpx}.primary{background:#18385f;color:#e4f1ff}

/* 蓝色渐变主题，仅作用于本页，保留现有布局和业务逻辑。 */
.my-top{background:linear-gradient(145deg,#dcecff 0%,#eef7ff 55%,#fff 100%)}
.member-card,.member-card-active{background:linear-gradient(125deg,#232321 0%,#111110 65%,#090909 100%);box-shadow:0 12rpx 28rpx rgba(9,9,9,.18)}
.profile-avatar-on{background:linear-gradient(135deg,#3286ee,#72c5f4);color:#fff}
.member-unlock{background:linear-gradient(135deg,#fff,#d8ecff);color:#205da8;box-shadow:0 5rpx 12rpx rgba(50,134,238,.16)}
.member-decor,.decor-two{border-color:rgba(208,231,255,.25)}
.profile-account,.auth-subtitle{color:#6d8199}
.auth-submit,.my-page .primary{background:linear-gradient(135deg,#2f80ed,#5aa9ef);color:#fff}
.auth-tab.active:after{background:#3286ee}
.member-promo-title,.member-crown{color:#e7b86a}.member-decor,.decor-two{border-color:rgba(231,184,106,.25)}
