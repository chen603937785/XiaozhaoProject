.page {
  padding-bottom: 40rpx;
}
.job-actions{display:flex;align-items:center;gap:22rpx}.job-actions button{margin:0}.company-name{color:#18385f}.company-count{color:#7d92a8}.tab.active{color:#3286ee}.company-meta-row{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding-top:14rpx;border-top:1rpx solid #eef2f6}.company-meta-row .company-time{margin-top:0}.text-action{padding:0;background:transparent;border:0;line-height:1;font-size:23rpx;font-weight:600}.text-action::after{border:0}.notice-action{color:#6f82a2}.apply-action{color:#3286ee}.follow-action{color:#f08a45}.follow-action.followed{color:#8ca0b5}

/* 顶部: 分栏 + 搜索 icon */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  gap: 16rpx;
  background: linear-gradient(115deg, #edf5ff, #f8fbff);
}
.tabs {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 8rpx;
  padding: 6rpx;
  background: #e6effa;
  border-radius: 24rpx;
}
.tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  white-space: nowrap;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 27rpx;
  font-weight: 500;
  color: #71869f;
  position: relative;
  padding: 15rpx 8rpx;
  line-height: 1.4;
  border-radius: 19rpx;
}
.tab.active {
  color: #2674cd;
  font-weight: 600;
  background: linear-gradient(135deg, #fff, #f1f7ff);
  box-shadow: 0 3rpx 10rpx rgba(50, 100, 160, .09);
}
.tab.active::after {
  content: none;
}
.search-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #e0ebfa;
  box-shadow: 0 3rpx 10rpx rgba(50,100,160,.04);
}

/* 搜索框(展开时) */
.search-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx 20rpx;
  background: #fff;
}
.search-input {
  flex: 1;
  background: #f2f3f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  height: 72rpx;
  font-size: 28rpx;
}
.search-btn {
  margin-left: 20rpx;
  color: #324263;
  font-size: 28rpx;
  font-weight: 500;
}

/* 筛选栏 */
.filter-scroll {
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  white-space: nowrap;
}
.filter-bar {
  display: inline-flex;
  padding: 0 12rpx;
}
.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
  color: #666;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.filter-item.active {
  color: #324263;
  font-weight: 500;
}
.arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #bbb;
}
.filter-item.active .arrow {
  color: #324263;
}



/* 结果数 + 更新时间 */
.sort-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
}
.sort-left {
  flex: 1;
}
.update-text {
  color: #324263;
  font-size: 22rpx;
}
.sort-right {
  color: #999;
}

/* 公司卡片 */
.company-list {
  padding: 0 24rpx;
}
.company-card {
  padding: 28rpx;
}
.company-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.company-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
}
.company-count {
  font-size: 24rpx;
  color: #fff;
  background: #eef4fb;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

/* 性质徽章(渐变) */
.nature-badge {
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.nature-central { background: #a8665c; }
.nature-private { background: #6b8796; }
.nature-foreign { background: #8b7d9c; }
.nature-institution { background: #ad8a63; }
.nature-public { background: #7a9a82; }
.nature-other { background: #9a9a9a; }

/* 信息行: 岗位/行业/地点 */
.info-row {
  display: flex;
  margin-bottom: 14rpx;
}
.info-label {
  width: 76rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999;
  line-height: 40rpx;
}
.info-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}
.pos-tag {
  display: inline-block;
  max-width: 320rpx;
  font-size: 22rpx;
  color: #324263;
  background: #f2f3f5;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin: 0 12rpx 8rpx 0;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}
.ind-tag {
  font-size: 22rpx;
  color: #666;
  background: #f2f3f5;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin: 0 12rpx 8rpx 0;
  line-height: 1.6;
}
.city-tag {
  font-size: 22rpx;
  color: #999;
  background: #f2f3f5;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin: 0 12rpx 8rpx 0;
  line-height: 1.6;
}

/* 时间 */
.company-time {
  display: flex;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.time-item {
  margin-right: 24rpx;
}
.time-deadline {
  color: #c2855c;
}
.time-today{color:#e34b4b;font-weight:600}

/* 加载状态 */
.loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 30rpx 0;
}

/* 筛选面板 */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 75vh;
}
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.panel-title {
  font-size: 32rpx;
  font-weight: 600;
}
.panel-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}
.panel-options {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}
.panel-option {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin: 12rpx;
  background: #f2f3f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #333;
}
.panel-option.selected {
  background: #eaf2ff;
  color: #324263;
  font-weight: 500;
}
.panel-option.back {
  background: #f2f3f5;
  color: #666;
}
.city-group {
  width: 100%;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 12rpx 4rpx;
  display: block;
}
.prov-badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #3286ee;
  color: #fff;
  font-size: 20rpx;
  margin-left: 8rpx;
}
.panel-footer {
  display: flex;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.panel-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.panel-btn.reset {
  background: #f2f3f5;
  color: #666;
  margin-right: 24rpx;
}
.panel-btn.confirm {
  background: linear-gradient(135deg, #2f80ed, #5db4f5);
  color: #fff;
}

/* 绑定手机号弹窗 */
.bind-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.bind-dialog {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 16rpx;
  width: 600rpx;
  padding: 40rpx 32rpx 32rpx;
  z-index: 201;
  text-align: center;
}
.bind-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.bind-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 28rpx;
}
.bind-input {
  background: #f2f3f5;
  border-radius: 8rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 28rpx;
  text-align: left;
}
.bind-btns {
  display: flex;
}
.bind-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.bind-btn.cancel {
  background: #f2f3f5;
  color: #666;
  margin-right: 20rpx;
}
.bind-btn.confirm {
  background: linear-gradient(135deg, #2f80ed, #5db4f5);
  color: #fff;
}

/* 与我匹配横条 */
.match-bar {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.match-info {
  flex: 1;
  margin-right: 20rpx;
}
.match-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.match-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}
.match-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #2f80ed, #5db4f5);
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
.company-header{align-items:flex-start;gap:16rpx}.company-name{flex:1;min-width:0;flex-wrap:wrap;gap:8rpx;line-height:1.5}
.company-card .nature-badge{margin-left:0;padding:3rpx 10rpx;font-size:20rpx;line-height:1.5;border-radius:8rpx;background:#edf5ff;color:#4778b0;border:1rpx solid #dae9fc}
.company-card .nature-central{background:#e7f0ff;color:#316ec0}.company-card .nature-institution{background:#edf2fa;color:#5b7398}.company-card .nature-other{background:#f2f5f9;color:#718198}
.deadline-text{max-width:190rpx;flex-shrink:0;font-size:21rpx;line-height:1.6;color:#8796a9;padding-top:5rpx;text-align:right;word-break:break-all;background:transparent}
.position-preview{flex:1;min-width:0;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;line-height:40rpx;max-height:80rpx;font-size:24rpx;color:#334d6e;word-break:break-all}
.location-row{align-items:flex-start;gap:8rpx}.location-row .info-tags{min-width:0}.recruit-label{max-width:180rpx;flex-shrink:0;padding:5rpx 12rpx;border-radius:10rpx;background:#eef5ff;color:#3976be;font-size:21rpx;line-height:30rpx;text-align:right}
.company-meta-row{gap:10rpx;flex-wrap:wrap}.company-time{flex-shrink:0}.job-actions{gap:10rpx;margin-left:auto}
.job-actions .text-action{padding:0 17rpx;height:54rpx;line-height:54rpx;border-radius:14rpx;font-size:22rpx;font-weight:600;border:1rpx solid #dce9f9;box-sizing:border-box}
.job-actions .notice-action{background:#f6f9fe;color:#587da9}.job-actions .apply-action{background:#eaf3ff;color:#2877d6}
.job-actions .follow-action{background:linear-gradient(135deg,#3286ee,#5ba6ef);color:#fff;border-color:transparent;box-shadow:0 4rpx 10rpx rgba(50,134,238,.12)}
.job-actions .follow-action.followed{background:#f0f4f8;color:#8a9caf;border-color:#e5ebf2;box-shadow:none}
