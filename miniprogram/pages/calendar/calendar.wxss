.calendar-page{padding-bottom:40rpx}.calendar-hero{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx 4rpx 30rpx}.calendar-kicker{font-size:19rpx;letter-spacing:3rpx;color:#6b9dd7;margin-bottom:10rpx}.calendar-hero .hero-title{font-size:34rpx;line-height:1.5;color:#21476f}.calendar-hero .hero-sub{font-size:22rpx;margin-top:8rpx}.calendar-emblem{flex-shrink:0;color:#3286ee;background:linear-gradient(145deg,#e2efff,#fff);border:1rpx solid #d8e8fc;border-radius:24rpx;width:72rpx;height:72rpx;line-height:72rpx;text-align:center;font-size:44rpx}
.calendar-card{padding:26rpx 18rpx 20rpx;background:#fff;border:1rpx solid #e0ebf8;border-radius:30rpx;box-shadow:0 10rpx 32rpx rgba(40,90,150,.05)}.month-head{display:flex;align-items:center;justify-content:space-between;margin:0 6rpx 22rpx;gap:12rpx}.month-title{font-size:31rpx;font-weight:700;color:#21476f}.month-controls{display:flex;gap:10rpx;align-items:center}.month-controls button{padding:0;margin:0;height:54rpx;line-height:54rpx;background:#f0f6ff;border-radius:16rpx;color:#347fda}.month-arrow{width:54rpx;font-size:34rpx}.month-controls .today-btn{padding:0 16rpx;font-size:22rpx}
.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx}.weekday{text-align:center;font-size:23rpx;color:#93a5b9;padding:10rpx 0 16rpx}.day{height:82rpx;position:relative;display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:28rpx;color:#385472;box-sizing:border-box;border:1rpx solid transparent}.day.today{background:#edf5ff;border-color:#b9d7fc;color:#3286ee}.day.chosen{background:linear-gradient(145deg,#3286ee,#60a7f1);color:#fff;border-color:transparent;box-shadow:0 5rpx 12rpx rgba(50,134,238,.18)}.dot{position:absolute;bottom:9rpx;width:7rpx;height:7rpx;border-radius:50%;background:#edac54}.chosen .dot{background:#fff}.calendar-legend{display:flex;align-items:center;gap:9rpx;border-top:1rpx solid #edf2f8;margin:22rpx 6rpx 0;padding-top:18rpx;color:#90a2b7;font-size:20rpx}.legend-dot{width:8rpx;height:8rpx;border-radius:50%;background:#edac54}.legend-hint{margin-left:auto}
.agenda-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:30rpx 2rpx 20rpx}.agenda-title{font-size:30rpx;color:#21476f;font-weight:700}.agenda-caption{font-size:21rpx;color:#8ba0b7;margin-top:8rpx}.new-todo-btn{flex-shrink:0;margin:0;padding:0 20rpx;height:66rpx;line-height:66rpx;background:linear-gradient(135deg,#3286ee,#59a2ef);color:#fff;font-size:24rpx;border-radius:20rpx;box-shadow:0 5rpx 14rpx rgba(50,134,238,.15)}
.todo-card{background:#fff;border:1rpx solid #e4edf8;border-radius:26rpx;margin-bottom:18rpx;padding:24rpx}.todo-card-head{display:flex;align-items:flex-start;gap:16rpx}.todo-mark{flex-shrink:0;width:58rpx;height:58rpx;line-height:58rpx;text-align:center;font-size:32rpx;border-radius:19rpx;background:#edf5ff;color:#3286ee}.todo-mark-done{background:#eff7f4;color:#589b7f}.todo-copy{flex:1;min-width:0}.task-title{font-size:28rpx;line-height:1.5;word-break:break-all;color:#254568}.task-title.done{color:#95a5b7}.todo-meta{font-size:21rpx;line-height:1.6;color:#859ab1;margin-top:6rpx;word-break:break-all}.todo-description{margin-top:18rpx;padding:16rpx;background:#f7faff;border-radius:14rpx;color:#71879f;font-size:23rpx;line-height:1.6;word-break:break-all}.todo-actions{display:flex;align-items:center;gap:12rpx;padding-top:18rpx;margin-top:18rpx;border-top:1rpx solid #edf2f8}.todo-state{font-size:21rpx;color:#9aabbd;margin-right:auto}.todo-actions button{margin:0;padding:0 18rpx;font-size:22rpx;height:56rpx;line-height:56rpx;border-radius:14rpx}.todo-delete{background:#fff;color:#ad8585}.todo-toggle{background:#eaf3ff;color:#3286ee}.calendar-empty{text-align:center;background:#fff;border-radius:26rpx;padding:40rpx 20rpx;color:#5c7c9f;font-size:27rpx;line-height:1.8}.calendar-empty text{font-size:23rpx;color:#94a7bc}.empty-calendar{height:80rpx;width:80rpx;line-height:80rpx;border-radius:25rpx;margin:0 auto 16rpx;background:#edf5ff;color:#6c9ed7;font-size:42rpx}
.form-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(20,40,66,.45);z-index:100}.todo-form{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:34rpx 34rpx 0 0;z-index:101;max-height:90vh;padding:28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;box-shadow:0 -10rpx 40rpx rgba(20,40,66,.1)}.form-heading{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:18rpx;gap:16rpx}.form-title{font-size:35rpx;font-weight:700;color:#21476f}.form-subtitle{margin-top:8rpx;font-size:22rpx;color:#8ba0b7}.form-close{margin:0;padding:0;width:54rpx;height:54rpx;line-height:50rpx;background:#f3f7fc;border-radius:50%;font-size:38rpx;color:#8ba0b7;flex-shrink:0}.form-body{max-height:55vh}.field-label{font-size:24rpx;font-weight:600;color:#526e8f;margin:20rpx 0 12rpx}.required{color:#de7f70}.optional{font-size:21rpx;font-weight:400;color:#9aabbd;margin-left:8rpx}.todo-input{background:#f5f8fd;border:1rpx solid #e5edf8;border-radius:18rpx;height:80rpx;box-sizing:border-box;padding:0 22rpx;font-size:26rpx;color:#21476f}.form-date-row{display:flex;gap:16rpx}.date-column{flex:1;min-width:0}.todo-picker{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:20rpx;background:#f5f8fd;border:1rpx solid #e5edf8;border-radius:18rpx;color:#426c9e;font-size:25rpx;min-height:76rpx;box-sizing:border-box}.plan-picker-text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.priority-row{display:flex;gap:14rpx}.priority-option{flex:1;margin:0;background:#f5f8fd;color:#7d93ac;border:1rpx solid #e5edf8;border-radius:18rpx;height:68rpx;line-height:66rpx;font-size:25rpx;padding:0}.priority-selected{color:#3286ee;border-color:#86b5ef;background:linear-gradient(135deg,#eaf3ff,#f7fbff);font-weight:600}.form-footer{display:flex;gap:18rpx;padding-top:22rpx}.form-footer button{margin:0;border-radius:22rpx;height:84rpx;line-height:84rpx;font-size:28rpx}.form-cancel{flex:1;background:#f0f5fc;color:#748da9}.form-save{flex:2;background:linear-gradient(135deg,#3286ee,#59a2ef);color:#fff}.calendar-page button::after,.todo-form button::after{border:0}.form-save[disabled]{opacity:.55}
