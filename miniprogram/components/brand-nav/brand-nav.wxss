.navigation{background:linear-gradient(115deg,#e4efff,#f5f9ff);box-sizing:border-box}
.navigation-row{display:flex;align-items:center;padding-left:14px;box-sizing:border-box}
.wordmark-area{display:flex;align-items:center;gap:8rpx;min-width:0;overflow:hidden}
.wordmark{display:flex;align-items:baseline;flex-shrink:0;color:#216bd0;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-weight:600;font-style:normal;letter-spacing:0;line-height:1.3}
.wordmark-main{font-size:38rpx}.wordmark-tail{font-size:32rpx;margin-left:5rpx}
.section{font-size:19rpx;color:#607fa5;background:rgba(255,255,255,.8);border-radius:8rpx;padding:4rpx 8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
